# Optional. Without a key, Resultwise runs fully offline.
# Set ONE of these in your terminal before `streamlit run app.py`, or paste the key in the app sidebar.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Model names change over time; override here if a default stops working.
RESULTWISE_CLAUDE_MODEL=claude-sonnet-5-5
RESULTWISE_OPENAI_MODEL=gpt-4.1-mini
