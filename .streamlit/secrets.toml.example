# Copy to .streamlit/secrets.toml locally, or paste into Streamlit Cloud: app Settings > Secrets
# Add ONE key. Free tiers: Gemini (aistudio.google.com) or Groq (console.groq.com)
GEMINI_API_KEY = "..."
# GROQ_API_KEY = "..."
# ANTHROPIC_API_KEY = "sk-ant-..."
# OPENAI_API_KEY = "sk-..."
# Optional overrides
# RESULTWISE_CLAUDE_MODEL = "claude-sonnet-5-5"
# RESULTWISE_CLAUDE_FAST_MODEL = "claude-haiku-5-5"
